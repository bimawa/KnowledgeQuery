
/// Re-index embeddings for changed files.
///
/// Compares content_hash in files table vs vec_chunks.
/// Clears stale chunks for changed files so they get re-embedded
/// on the next vector search.
pub fn reindex_embeddings(conn: &Connection) -> Result<usize> {
    let mut stmt = conn.prepare(
        "SELECT f.id, f.path FROM files f
         LEFT JOIN vec_chunks vc ON vc.file_id = f.id
         WHERE vc.rowid IS NULL
            OR vc.content_hash != f.content_hash
         GROUP BY f.id"
    )?;

    let changed: Vec<(i64, String)> = stmt.query_map([], |row| {
        Ok((row.get(0)?, row.get(1)?))
    })?
    .filter_map(|r| r.ok())
    .collect();

    if changed.is_empty() {
        return Ok(0);
    }

    for (file_id, _path) in &changed {
        let mut del = conn.prepare("DELETE FROM vec_chunks WHERE file_id = ?1")?;
        del.execute(rusqlite::params![file_id])?;
    }

    Ok(changed.len())
}
